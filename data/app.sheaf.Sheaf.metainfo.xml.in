<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.sheaf.Sheaf</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Sheaf</name>
  <summary>Save code snippets, plain text, and Markdown notes</summary>
  <developer id="app.sheaf">
    <name>Jitendra Vyas</name>
  </developer>
  <description>
    <p>
      Sheaf is a local scratchpad for Linux. Keep the commands and
      fragments you reuse — pacman, git, ssh, python, rsync — write a plain
      text reminder, or draft Markdown. Search instantly and copy the body
      to the clipboard in one action.
    </p>
    <p>Features:</p>
    <ul>
      <li>Write each item as code, plain text, or Markdown</li>
      <li>Sidebar list with title, format tag (bash / text / md), and a one-line preview</li>
      <li>Instant search across title, language, and body</li>
      <li>Code mode highlights syntax and auto-detects language on paste</li>
      <li>Markdown preview for headings, lists, emphasis, code, and links</li>
      <li>Copy the body from the list, Ctrl+Shift+C, or Ctrl+C when nothing is selected</li>
      <li>New note (Ctrl+N) and delete with undo</li>
      <li>Automatic save to your user data directory</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/jitendravyas/sheaf</url>
  <url type="bugtracker">https://github.com/jitendravyas/sheaf/issues</url>
  <url type="vcs-browser">https://github.com/jitendravyas/sheaf</url>
  <launchable type="desktop-id">app.sheaf.Sheaf.desktop</launchable>
  <provides>
    <binary>sheaf</binary>
  </provides>
  <branding>
    <color type="primary" scheme_preference="light">#f6e27a</color>
    <color type="primary" scheme_preference="dark">#c9a227</color>
  </branding>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <recommends>
    <display_length compare="ge">768</display_length>
  </recommends>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-08-23">
      <description>
        <p>Code, plain text, and Markdown notes with search and one-click copy.</p>
      </description>
    </release>
  </releases>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/jitendravyas/sheaf/main/screenshot.png</image>
      <caption>Code snippet with syntax highlighting</caption>
    </screenshot>
  </screenshots>
  <categories>
    <category>Utility</category>
    <category>Development</category>
  </categories>
  <keywords>
    <keyword>snippets</keyword>
    <keyword>code</keyword>
    <keyword>text</keyword>
    <keyword>markdown</keyword>
    <keyword>notes</keyword>
    <keyword>scratchpad</keyword>
    <keyword>clipboard</keyword>
    <keyword>bash</keyword>
    <keyword>python</keyword>
  </keywords>
</component>
