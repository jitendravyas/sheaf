<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.jitendravyas.Notes</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Snippets</name>
  <summary>Save and copy local code snippets</summary>
  <developer id="io.github.jitendravyas">
    <name>Jitendra Vyas</name>
  </developer>
  <description>
    <p>
      Snippets is a local code snippet scratchpad for Linux. Keep the commands
      and fragments you reuse — pacman, git, ssh, python, rsync — search them
      instantly, and copy the body to the clipboard in one action.
    </p>
    <p>Features:</p>
    <ul>
      <li>Sidebar list with title, language, and a one-line preview</li>
      <li>Instant search across title, language, and body</li>
      <li>Title, language tag, and monospace editor</li>
      <li>Copy snippet (toolbar, Ctrl+Shift+C, or Ctrl+C when nothing is selected)</li>
      <li>New snippet (Ctrl+N) and delete with confirmation</li>
      <li>Automatic save to your user data directory</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/jitendravyas/omarchy-notes</url>
  <url type="bugtracker">https://github.com/jitendravyas/omarchy-notes/issues</url>
