#: data/app.sheaf.Sheaf.metainfo.xml.in:12
msgid ""
"Sheaf is a local scratchpad for Linux. Keep the commands and fragments you "
"reuse — pacman, git, ssh, python, rsync — write a plain text reminder, or "
"draft Markdown. Search instantly and copy the body to the clipboard in one "
"action."
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:18
msgid "Features:"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:20
msgid "Write each item as code, plain text, or Markdown"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:21
msgid ""
"Sidebar list with title, format tag (bash / text / md), and a one-line "
"preview"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:22
msgid "Instant search across title, language, and body"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:23
msgid "Code mode highlights syntax and auto-detects language on paste"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:24
msgid "Markdown preview for headings, lists, emphasis, code, and links"
msgstr ""

#: data/app.sheaf.Sheaf.metainfo.xml.in:25
